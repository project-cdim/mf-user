############################################################
## Stage.1 Rebuild the source code only when needed
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:1-1776863671@sha256:670c207e6872898228015fa8ec2e4165cfa13089a9e5fccb4f9c6d6cda2811ba AS builder

ENV NEXT_TELEMETRY_DISABLED 1

USER root

# Note: Base image is pinned by digest for reproducibility.
# microdnf update is intentionally omitted to maintain consistent package versions.
# Base image updates should be handled through periodic base image tag reviews.
WORKDIR /app

# Install dependencies
COPY package*.json /app/
RUN npm ci && npm cache clean --force

# Build the application
ENV NODE_ENV production
COPY . /app/
RUN --mount=type=secret,id=dotenv,target=/app/.env \
    npm run build && \
    rm -f /app/.next/standalone/.env

# Switch to non-root user
USER 1001

############################################################
## Stage 2 Production image, copy all the files and run next
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:1-1776863671@sha256:670c207e6872898228015fa8ec2e4165cfa13089a9e5fccb4f9c6d6cda2811ba

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

# Switch to non-root user
USER 1001

WORKDIR /app

# Copy necessary files from the build stage
COPY --from=builder --chown=1001:1001 /app/.next/standalone /app/
COPY --from=builder --chown=1001:1001 /app/.next/static /app/.next/static/
COPY --from=builder --chown=1001:1001 /app/public/ /app/public/

# Start the application
CMD ["node", "server.js"]